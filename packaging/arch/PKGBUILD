# Maintainer: TR-RBM <47713618+TR-RBM@users.noreply.github.com>
#
# Arch Linux, Artix and other pacman distributions:
#   makepkg -si
# The release workflow builds this file and attaches the package.

pkgname=calc-exact
pkgver=0.1.0
pkgrel=1
pkgdesc="A calculator for the command line that keeps every result exact as long as the mathematics allows"
arch=('x86_64' 'aarch64')
url="https://github.com/TR-RBM/calc"
license=('Apache-2.0' 'CC-BY-SA-4.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
provides=('calc')
conflicts=('calc')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "calc-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "calc-$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p calc-cli
}

check() {
    cd "calc-$pkgver"
    export CARGO_TARGET_DIR=target
    target/release/calc "1/3 + 1/6" --terse | grep -qx '1/2 exact'
}

package() {
    cd "calc-$pkgver"
    install -Dm755 target/release/calc "$pkgdir/usr/bin/calc"
    install -Dm644 crates/calc-cli/completion/calc.bash "$pkgdir/usr/share/bash-completion/completions/calc"
    install -Dm644 crates/calc-cli/completion/calc.fish "$pkgdir/usr/share/fish/vendor_completions.d/calc.fish"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 LICENSE-CONTENT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-CONTENT"
}
